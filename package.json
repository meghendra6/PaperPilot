{
  "name": "zotero-paper-pilot",
  "version": "0.1.4",
  "description": "Paper Pilot: Zotero plugin",
  "config": {
    "addonName": "Paper Pilot",
    "addonID": "paperpilot@harampark.com",
    "addonRef": "paperpilot",
    "addonInstance": "PaperPilot",
    "prefsPrefix": "extensions.zotero.paperpilot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meghendra6/PaperPilot.git"
  },
  "author": "Scott Lee",
  "bugs": {
    "url": "https://github.com/meghendra6/PaperPilot/issues"
  },
  "homepage": "https://github.com/meghendra6/PaperPilot",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./scripts/prepare-opendataloader.mjs && node ./scripts/zotero-plugin-cli.mjs serve",
    "build": "npm run typecheck && node ./scripts/prepare-opendataloader.mjs && node ./scripts/zotero-plugin-cli.mjs build",
    "lint:check": "prettier --check src test scripts addon docs README*.md AGENTS.md CLAUDE.md CONTRIBUTING.md package.json package-lock.json tsconfig*.json eslint.config.mjs .github/workflows && eslint src test scripts",
    "lint:fix": "prettier --write src test scripts addon docs README*.md AGENTS.md CLAUDE.md CONTRIBUTING.md package.json package-lock.json tsconfig*.json eslint.config.mjs .github/workflows && eslint src test scripts --fix",
    "release": "npm run typecheck && node ./scripts/prepare-opendataloader.mjs && node ./scripts/zotero-plugin-cli.mjs release",
    "test": "node --require ts-node/register/transpile-only --test test/*.test.ts",
    "test:unit": "node --require ts-node/register/transpile-only --test $(find test -name '*.test.ts' ! -name 'runCompletion.test.ts' ! -name 'autoHighlightPdfMatch.test.ts')",
    "test:integration": "node --require ts-node/register/transpile-only --test test/runCompletion.test.ts test/autoHighlightPdfMatch.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "check-deps": "npm outdated"
  },
  "dependencies": {
    "katex": "^0.16.44",
    "pdfjs-dist": "^4.6.82",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@opendataloader/pdf": "2.2.0",
    "@eslint/js": "^9.9.1",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.19.1",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
