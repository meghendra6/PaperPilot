pref-surface-title = Paper Pilot settings
pref-surface-intro = Configure Codex CLI, Claude Code, their shared workspace, retrieval, and local session history.

pref-section-general-title = General
pref-section-general-desc = Reader pane defaults for every paper.
pref-general-default-mode = Default AI mode
pref-general-default-mode-codex = Codex CLI
pref-general-default-mode-claude = Claude Code
pref-general-default-mode-unrecognized = “{ $value }” (not recognized, uses Codex CLI)
pref-general-response-language = Response language
pref-general-response-language-english = English
pref-general-response-language-korean = Korean
pref-general-response-language-chinese = Chinese

pref-section-workspace-title = Workspace
pref-section-workspace-desc = Codex CLI and Claude Code both use these settings for the local folders that each run reads and writes.
pref-workspace-root = Workspace root
pref-workspace-root-input =
    .placeholder = Optional folder path
pref-workspace-root-help = Leave empty to use a private folder in the Zotero temporary directory.
pref-workspace-clean = Auto-clean temp workspace
pref-workspace-clean-help = Removes the files that Paper Pilot wrote for a run after the run ends. When session history is off, Paper Pilot always removes them.

pref-effort-low = Low
pref-effort-medium = Medium
pref-effort-high = High
pref-effort-xhigh = Extra high (xhigh)
pref-effort-max = Max
pref-effort-ultra = Ultra

pref-section-claude-title = Claude Code
pref-section-claude-desc = Claude Code executable, model, effort, and permission options.
pref-claude-executable-path = Claude executable path
pref-claude-executable-path-input =
    .placeholder = /Users/me/.local/bin/claude
pref-claude-default-model = Claude default model
pref-claude-default-model-input =
    .placeholder = sonnet, opus, claude-opus-5-5, claude-opus-5-5[1m]
pref-claude-allowed-models = Claude allowed models
pref-claude-allowed-models-input =
    .placeholder = Comma-separated Claude Code model IDs
pref-claude-reasoning-effort = Claude effort
pref-claude-reasoning-effort-default = Claude Code default
pref-claude-reasoning-effort-unrecognized = “{ $value }” (not recognized, uses Claude Code default)
pref-claude-permission-mode = Claude permission mode
pref-claude-permission-mode-default = Default
pref-claude-permission-mode-accept-edits = Accept edits
pref-claude-permission-mode-plan = Plan mode
pref-claude-permission-mode-auto = Auto
pref-claude-permission-mode-dont-ask = Don't ask
pref-claude-permission-mode-bypass-permissions = Bypass permissions
pref-claude-permission-mode-unrecognized = “{ $value }” (not recognized, uses Default)
pref-claude-permission-mode-help = Applies to chat runs. Other Paper Pilot workflows always use Plan mode.

pref-section-codex-title = Codex CLI
pref-section-codex-desc = Codex CLI executable, model, reasoning, web search, sandbox, and approval options.
pref-codex-executable-path = Codex executable path
pref-codex-executable-path-input =
    .placeholder = /usr/local/bin/codex
pref-codex-default-model = Codex default model
pref-codex-default-model-input =
    .placeholder = gpt-6-astra
pref-codex-allowed-models = Codex allowed models
pref-codex-allowed-models-input =
    .placeholder = Comma-separated Codex model IDs
pref-codex-reasoning-effort = Codex reasoning effort
pref-codex-reasoning-effort-unrecognized = “{ $value }” (not recognized, uses the model default)
pref-codex-reasoning-effort-help = A model that does not support the selected effort uses its own default.
pref-codex-web-search = Allow web search when needed
pref-codex-sandbox-mode = Codex sandbox mode
pref-codex-sandbox-mode-read-only = Read only
pref-codex-sandbox-mode-workspace-write = Write inside the workspace
pref-codex-sandbox-mode-danger-full-access = Full access, no sandbox
pref-codex-sandbox-mode-unrecognized = “{ $value }” (not recognized, uses Read only)
pref-codex-sandbox-mode-help = Applies to chat runs. Other Paper Pilot workflows always run read only.
pref-codex-approval-mode = Codex approval mode
pref-codex-approval-mode-never = Never ask
pref-codex-approval-mode-on-request = Ask when Codex requests it
pref-codex-approval-mode-untrusted = Ask before untrusted commands
pref-codex-approval-mode-on-failure = Ask after a command fails
pref-codex-approval-mode-unrecognized = “{ $value }” (not recognized, uses the Codex CLI configuration)

pref-section-retrieval-title = Retrieval
pref-section-retrieval-desc = Controls which paper text Paper Pilot adds to reader pane questions.
pref-retrieval-include-abstract = Include abstract
pref-retrieval-nearby-context = Include nearby selection context
pref-retrieval-advanced = Advanced retrieval
pref-retrieval-advanced-desc = Paper Pilot splits the paper text into overlapping chunks. The chunks that best match a question go into the prompt.
pref-retrieval-chunk-size = Chunk size (characters)
pref-retrieval-chunk-size-help = Characters of paper text in each chunk.
pref-retrieval-chunk-size-adjusted = Paper Pilot uses { $effective } characters. Use a chunk size from { $min } to { $max }.
pref-retrieval-overlap-size = Overlap (characters)
pref-retrieval-overlap-size-help = Characters that neighboring chunks share. Use at most half the chunk size.
pref-retrieval-overlap-size-adjusted = Paper Pilot uses { $effective } characters. Use an overlap from 0 to { $max }, half the chunk size.
pref-retrieval-top-k = Chunks per question (top-k)
pref-retrieval-top-k-help = Number of best-matching chunks that go into each question.

pref-section-privacy-title = Privacy
pref-section-privacy-desc = Local session history and privacy controls.
pref-privacy-history-mode = Session history
pref-privacy-history-mode-full = Save prompts and responses
pref-privacy-history-mode-prompts-only = Save prompts only
pref-privacy-history-mode-disabled = Do not save session history
pref-privacy-history-mode-help = Paper Pilot keeps session history for each paper in your Zotero profile on this computer.
pref-privacy-redact-paths = Redact local file paths
